# Supabase 服务端数据源。
# 当前项目的浏览器端不直接保存数据，前端统一通过 /api/deliveries 访问服务端。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 可选：显式强制服务端使用指定数据源。Docker 默认使用 sqlite。
# DATA_STORE=supabase
# DATA_STORE=sqlite
DATA_STORE=

# 可选：SQLite 数据库文件路径。Docker 镜像默认固定为 /app/data/deliveries.sqlite；
# 本地不配置时默认使用 data/deliveries.sqlite。
# SQLITE_DB_PATH=data/deliveries.sqlite

# 管理员密码的首次引导值，未配置时默认使用 123456。数据库设置密码后，会优先使用数据库中的加盐哈希。
# 生产环境请设置强密码，或首次登录后立即在系统设置中修改。
ADMIN_API_TOKEN=123456

# 使用 Supabase 存储管理员密码时必须配置。该密钥只由服务端读取，绝不能暴露给浏览器。
SUPABASE_SERVICE_ROLE_KEY=
